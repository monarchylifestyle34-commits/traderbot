# Copy this to .env and fill in your real values. Never commit .env.

# --- Broker selection: tradovate or fusion_ctrader ---
BROKER=tradovate

# --- Tradovate credentials (demo first!) ---
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_ACCOUNT_ID=
TRADOVATE_ENV=demo
# Optional JSON mapping from TradingView tickers to Tradovate contracts.
# Example: {"MES1!":"MESU6"}
TRADOVATE_SYMBOL_MAP={}

# --- Fusion Markets cTrader Open API (demo first!) ---
# These are cTrader Open API credentials, not your Fusion login password.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
# Use the ctidTraderAccountId returned by Open API, not the UI login number.
CTRADER_ACCOUNT_ID=
CTRADER_ENV=demo
CTRADER_LOTS_PER_TRADE=0.01
CTRADER_REQUEST_TIMEOUT_SEC=10
# Example: {"EURUSD":"EURUSD","XAUUSD":"XAUUSD"}
CTRADER_SYMBOL_MAP={}

# --- Webhook security ---
# Generate a long random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# --- Risk limits ---
MAX_CONTRACTS_PER_TRADE=1
MAX_OPEN_POSITIONS=1
DAILY_LOSS_LIMIT_USD=500
ENTRY_WATCH_TIMEOUT_SEC=1800

# --- Server ---
BOT_HOST=0.0.0.0
BOT_PORT=8000
